class TimeMap:

    def __init__(self):
        self.mapping = defaultdict(list)

    def set(self, key: str, value: str, timestamp: int) -> None:
        index = len(self.mapping[key]) - 1
        while (index >= 0) and (self.mapping[key][index][1] > timestamp):
            index -= 1
        self.mapping[key].insert(index + 1, [value, timestamp])
            

    def get(self, key: str, timestamp: int) -> str:
        if len(self.mapping[key]) == 0:
            return ""
        arr = self.mapping[key]
        upper = len(arr) - 1
        lower = 0
        result = ""
        while upper >= lower:
            mid = (upper + lower) // 2
            if arr[mid][1] <= timestamp:
                result = arr[mid][0]
                lower = mid + 1
            elif arr[mid][1] > timestamp: 
                upper = mid - 1
        
        return result


